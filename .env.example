# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to backend/ directory).
DATABASE_URL=sqlite:///./data/finance.db

# ── Gmail OAuth2 ──────────────────────────────────────────────────────────────
# Path to the OAuth2 client secret JSON downloaded from Google Cloud Console.
# Generate at: console.cloud.google.com → APIs & Services → Credentials → Desktop app
GMAIL_CREDENTIALS_FILE=secrets/credentials.json

# Path where the authorised token will be written after first OAuth login.
GMAIL_TOKEN_FILE=secrets/token.json

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Gmail label to restrict ingestion to (must exist in your Gmail account).
GMAIL_LABEL=Finance

# Seconds to wait between poll cycles in daemon mode (finance-tracker poll).
POLL_SECONDS=300

# Number of days to look back on the very first ingest run (no stored cursor).
INITIAL_LOOKBACK_DAYS=30

# Minimum parse confidence score (0–100) required to accept a transaction.
# Messages scoring below this are routed to the unparsed queue.
CONFIDENCE_THRESHOLD=50

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── General ───────────────────────────────────────────────────────────────────
# "development" enables SQLAlchemy query logging. Use "production" in Docker.
ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
